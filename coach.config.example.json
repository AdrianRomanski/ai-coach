{
  "vault": "~/Documents/life-vault",
  "docsMcpBin": "~/projects/kb-template/packages/cli/bin/docs-mcp.js",
  "ollama": {
    "model": "<a Gemma model from `ollama list`>",
    "host": "http://127.0.0.1:11434",
    "contextWindow": 16384
  },
